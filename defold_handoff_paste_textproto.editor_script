---@class defold_handoff_paste_textproto
---@field opened_gui_file string?
local M = {
  opened_gui_file = nil
}

---@param string string
---@return string
local function normalize_string(string)
  string = string:gsub("\r\n", "\n"):gsub("\r", "\n")
  string = string:gsub("[ \t]+\n", "\n")
  string = string:gsub("[ \t]+$", "")
  return string
end

---@param block string
---@param attribute string
---@return string?
local function parse_attribute_value(block, attribute)
  return block:match("\n  " .. attribute .. ": ([^\n]+)")
end

---@param text string
---@param block_name string
---@return integer?
local function find_last_block_end(text, block_name)
  local left_index = 1
  local last_end = nil
  while true do
    local start_position = text:find(block_name .. "%s*%b{}", left_index)
    if not start_position then break end
    local open_brace = text:find("{", start_position)
    if not open_brace then break end
    local depth = 1
    local right_index = open_brace + 1
    while right_index <= #text and depth > 0 do
      local character = text:sub(right_index, right_index)
      if character == "{" then
        depth = depth + 1
      elseif character == "}" then
        depth = depth - 1
      end
      right_index = right_index + 1
    end
    last_end = right_index - 1
    left_index = right_index
  end
  return last_end
end

---@param text string
---@param block_name string
---@return string[]
local function extract_blocks(text, block_name)
  local nodes = {}
  local left_index = 1
  while true do
    local start_position = text:find(block_name .. '%s*%b{}', left_index)
    if not start_position then
      break
    end
    local open_brace = text:find("{", start_position)
    local depth = 1
    local right_index = open_brace + 1
    while right_index <= #text and depth > 0 do
      local character = text:sub(right_index, right_index)
      if character == "{" then
        depth = depth + 1
      elseif character == "}" then
        depth = depth - 1
      end
      right_index = right_index + 1
    end
    local block = text:sub(start_position, right_index - 1)
    table.insert(nodes, block)
    left_index = right_index
  end
  return nodes
end

---@param blocks string[]
---@param new_blocks string[]
---@param attribute string
---@return string[]
local function merge_unique_blocks(blocks, new_blocks, attribute)
  local unique_blocks = {}
  local seen = {}
  for _, block in ipairs(blocks) do
    local value = parse_attribute_value(block, attribute)
    if value ~= nil then
      local normalized_value = normalize_string(value)
      seen[normalized_value] = true
    end
  end
  for _, new_block in ipairs(new_blocks) do
    local value = parse_attribute_value(new_block, attribute)
    if value then
      local normalized_value = normalize_string(value)
      if (not seen[normalized_value]) then
        seen[normalized_value] = true
        table.insert(unique_blocks, new_block)
      end
    end
  end
  return unique_blocks
end

---@param text string
---@param new_blocks string[]
---@param category string
---@return string
local function insert_blocks(text, new_blocks, category)
  local new_content = table.concat(new_blocks)
  local last_end = find_last_block_end(text, category)
  if last_end then
    local before = text:sub(1, last_end)
    local after  = text:sub(last_end + 1)
    if before:sub(-1) ~= "\n" then
      before = before .. "\n"
    end
    return before .. new_content .. "\n" .. after
  end
  if text:sub(-1) ~= "\n" then text = text .. "\n" end
  return text .. new_content .. "\n"
end

---@param node string
---@param parent_id string
---@return string
local function insert_parent_if_missing(node, parent_id)
  if not node:find("parent:", 1, true) then
    local indent = node:match("\n([ \t]*)id%s*:") or node:match("\n([ \t]*)[%w_]+%s*:") or "  "
    local parent_line = indent .. 'parent: "' .. parent_id .. '"\n'
    local with_parent, position = node:gsub("(\n[ \t]*id%s*:%s*\"[^\"]*\"[ \t]*\n)", "%1" .. parent_line, 1)
    if position > 0 then
      return with_parent
    end
    with_parent, position = node:gsub("(%{%s*\n)", "%1" .. parent_line, 1)
    if position > 0 then
      return with_parent
    end
    local brace_position = node:find("{", 1, true)
    if brace_position then
      return node:sub(1, brace_position) .. "\n" .. parent_line .. node:sub(brace_position + 1)
    end
    return node .. "\n" .. parent_line
  end
  return node
end

---@param new_nodes string[]
---@param parent_id string
local function update_empty_nodes_parent(new_nodes, parent_id)
  for i, node in ipairs(new_nodes) do
    new_nodes[i] = insert_parent_if_missing(node, parent_id)
  end
end

---@param file string
---@param clipboard string
---@param parent_id string?
---@return string
local function add_nodes(file, clipboard, parent_id)
  local new_nodes = extract_blocks(clipboard, "nodes")
  if (parent_id) then
    update_empty_nodes_parent(new_nodes, parent_id)
  end
  file = insert_blocks(file, new_nodes, "nodes")
  return file
end

---@param file string
---@param clipboard string
---@return string
local function merge_resources(file, clipboard)
  local existing_fonts = extract_blocks(file, "fonts")
  local incoming_fonts = extract_blocks(clipboard, "fonts")
  local new_fonts = merge_unique_blocks(existing_fonts, incoming_fonts, "name")
  if #new_fonts > 0 then
    file = insert_blocks(file, new_fonts, "fonts")
  end
  local existing_textures = extract_blocks(file, "textures")
  local incoming_textures = extract_blocks(clipboard, "textures")
  local new_textures = merge_unique_blocks(existing_textures, incoming_textures, "name")
  if #new_textures > 0 then
    file = insert_blocks(file, new_textures, "textures")
  end
  return file
end

---@param path string
---@param extension string
---@return boolean
local function has_extension(path, extension)
  extension = extension:gsub("^%.*", ""):lower()
  local name = path:match("([^/\\]+)$") or path
  local extracted_extension = name:match("%.([^%.]+)$")
  return extracted_extension ~= nil and extracted_extension:lower() == extension
end

local function get_clipboard()
  if editor.platform == "x86_64-win32" then
    return editor.execute("powershell", "-NoProfile", "-Command", "\"Get-Clipboard\"",
      { out = "capture", reload_resources = false })
  elseif editor.platform == "x86_64-macos" then
    return editor.execute("pbpaste", { out = "capture", reload_resources = false })
  end
  return editor.execute("xclip", "-selection", "clipboard", "-o", { out = "capture", reload_resources = false })
end

---@param path string
---@param mode string
---@return file*?, string?
local function open_file(path, mode)
  local file, error = io.open(path, mode)
  if error then
    print("Error:", error)
    return nil
  end
  return file
end

---@param path string
---@return string?
local function read_file(path)
  local file = open_file(path, "rb")
  if not file then return nil end
  local content = file:read("*a")
  file:close()
  return content
end

---@param path string
---@param content string
---@return boolean
local function write_file(path, content)
  local file = open_file(path, "wb")
  if not file then return false end
  file:write(content)
  file:close()
  return true
end

---@param text string
---@return string
local function try_parse_filename(text)
  local nodes = extract_blocks(text, "nodes")
  for _, node in ipairs(nodes) do
    if not node:find("parent:", 1, true) then
      local filename = node:match('%sid%s*:%s*"([^"]+)"')
      if (filename) then
        return filename .. ".gui"
      end
    end
  end
  return "gui_component.gui"
end

local function resolve_opened_gui_file(options)
  if (editor.can_get(options.selection, "path")) then
    local path = editor.get(options.selection, "path")
    if has_extension(path, ".gui") then
      M.opened_gui_file = path
    else
      M.opened_gui_file = nil
    end
  end
end

function M.get_commands()
  return {
    {
      label = "Paste from Defold Handoff as a New GUI File",
      locations = { "Assets" },
      query = {
        selection = { type = "resource", cardinality = "one" }
      },
      active = function(options)
        return true
      end,
      run = function(options)
        local clipboard = get_clipboard()
        local filename = try_parse_filename(clipboard)
        local path = editor.get(options.selection, "path")
        local file_path = "./" .. path .. "/" .. filename
        write_file(file_path, clipboard)
      end
    },
    {
      label = "Paste from Defold Handoff",
      locations = { "Outline" },
      query = {
        selection = { type = "outline", cardinality = "one" }
      },
      active = function(options)
        return M.opened_gui_file ~= nil
      end,
      run = function(options)
        editor.save()
        local clipboard = get_clipboard()
        local abs = editor.external_file_attributes("." .. M.opened_gui_file).path
        local content = read_file(abs)
        if content then
          local updated_content = content
          local parent_id = editor.can_get(options.selection, "id") and editor.get(options.selection, "id") or nil
          updated_content = add_nodes(updated_content, clipboard, parent_id)
          updated_content = merge_resources(updated_content, clipboard)
          local success = write_file(abs, updated_content)
          if success then
            editor.save()
          end
        end
      end
    },
    {
      label = "Defold Handoff",
      locations = { "Edit" },
      query = {
        selection = { type = "outline", cardinality = "one" }
      },
      active = function(options)
        resolve_opened_gui_file(options)
        return true
      end,
      run = function(options)
        resolve_opened_gui_file(options)
      end
    },
  }
end

return M
